---
const {
	title = 'Home',
	description = 'Curated launchpad of links',
} = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏠</text></svg>" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<script is:inline>
			const theme = localStorage.getItem('theme') ??
				(matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

			document.documentElement.classList.toggle('dark', theme === 'dark');
			document.documentElement.setAttribute('data-theme', theme);
			localStorage.setItem('theme', theme);
		</script>
	</head>
	<body>
		<div class="page">
			<button id="theme-toggle" aria-label="Toggle theme">
				<svg class="sun" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
				<svg class="moon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
			</button>
			<slot />
		</div>

		<script>
			const handleToggleClick = () => {
				const element = document.documentElement;
				element.classList.toggle("dark");
		
				const isDark = element.classList.contains("dark");
				const theme = isDark ? "dark" : "light";
				element.setAttribute("data-theme", theme);
				localStorage.setItem("theme", theme);
			};
		
			document.getElementById("theme-toggle")?.addEventListener("click", handleToggleClick);
		</script>
	</body>
</html>

<style>
	:root {
		color-scheme: light;
		--bg: #f8fafc;
		--text: #1e293b;
		--muted: #64748b;
		--panel: rgba(255, 255, 255, 0.7);
		--border: rgba(0, 0, 0, 0.08);
		--text-hover: #0f172a;
		--shadow: 0 18px 50px rgba(0, 0, 0, 0.12);
	}

	[data-theme="dark"] {
		color-scheme: dark;
		--bg: #0b1220;
		--text: #e6ecff;
		--muted: #9fb2d8;
		--panel: rgba(255, 255, 255, 0.04);
		--border: rgba(255, 255, 255, 0.1);
		--text-hover: #ffffff;
		--shadow: 0 18px 50px rgba(0, 0, 0, 0.28);
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		min-height: 100vh;
		background:
			radial-gradient(circle at 12% 18%, rgba(97, 120, 255, 0.32), transparent 32%),
			radial-gradient(circle at 82% 16%, rgba(255, 138, 92, 0.22), transparent 28%),
			radial-gradient(circle at 10% 70%, rgba(111, 225, 193, 0.18), transparent 32%),
			var(--bg);
		background-attachment: fixed;
		color: var(--text);
		font-family: system-ui, -apple-system, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
		-webkit-font-smoothing: antialiased;
		transition: background-color 0.3s ease, color 0.3s ease;
	}

	.page {
		min-height: 100vh;
		padding: 48px 20px 64px;
		position: relative;
		isolation: isolate;
	}

	.page::before {
		content: '';
		position: absolute;
		inset: 12% auto auto 8%;
		width: 180px;
		height: 180px;
		filter: blur(70px);
		opacity: 0.35;
		background: linear-gradient(140deg, #7cc9ff, #a18bff);
		z-index: -1;
	}

	.page::after {
		content: '';
		position: absolute;
		inset: auto 12% 10% auto;
		width: 200px;
		height: 200px;
		filter: blur(80px);
		opacity: 0.28;
		background: linear-gradient(200deg, #ffae70, #ff6682);
		z-index: -1;
	}

	#theme-toggle {
		position: absolute;
		top: 24px;
		right: 24px;
		background: var(--panel);
		border: 1px solid var(--border);
		color: var(--text);
		cursor: pointer;
		padding: 8px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.2s ease;
		backdrop-filter: blur(12px);
		z-index: 10;
	}

	#theme-toggle:hover {
		transform: scale(1.1);
		border-color: var(--muted);
	}

	.sun { display: none; }
	.moon { display: block; }

	:global([data-theme="dark"]) .sun { display: block; }
	:global([data-theme="dark"]) .moon { display: none; }

	a {
		color: inherit;
	}

	@media (min-width: 900px) {
		.page {
			padding: 72px 64px 96px;
		}
		
		#theme-toggle {
			top: 32px;
			right: 32px;
		}
	}
</style>
