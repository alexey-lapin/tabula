---
import type { Hero } from '../types.ts';

interface Props {
	hero: Hero;
}

const { hero } = Astro.props;
---

<section class="intro">
	<h1>{hero.title ?? 'Personal link launchpad'}</h1>
	{hero.description && <p class="lede">{hero.description}</p>}
</section>

<style>
	.intro {
		display: grid;
		gap: 10px;
		max-width: 720px;
	}

	h1 {
		margin: 0;
		font-size: clamp(32px, 5vw, 44px);
		letter-spacing: -0.02em;
	}

	.lede {
		margin: 0;
		color: var(--muted);
		font-size: 18px;
		line-height: 1.5;
	}
</style>
