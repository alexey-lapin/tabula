---
import type { Category } from '../types.ts';
import LinkItem from './LinkItem.astro';

interface Props {
	category: Category;
	parentVars?: Record<string, string | number>;
}

const { category, parentVars } = Astro.props;
const links = category.links ?? [];
const children = category.children ?? [];
const hasLinks = links.length > 0;
const hasChildren = children.length > 0;
const mergedVars = { ...(parentVars ?? {}), ...(category.vars ?? {}) };
---

<article class:list={["card", { "card--transparent": category.transparent }]} aria-label={category.name} style={`--card-width: ${category.cardWidth ?? 4}${category.background ? `; --card-bg: ${category.background}` : ''}`}>
	<header class="card__header">
		{category.accent && <span class="dot" style={`--dot: ${category.accent}`}></span>}
		<div>
			{category.kicker && <p class="eyebrow">{category.kicker}</p>}
			<h2>{category.name}</h2>
			{category.description && <p class="muted">{category.description}</p>}
		</div>
	</header>
	{hasLinks && (
		<ul class="links">
			{links.map((link) => <LinkItem link={link} vars={mergedVars} />)}
		</ul>
	)}
	{hasChildren && (
		<div class="card__children">
			{children.map((child) => (
				<Astro.self category={child} parentVars={mergedVars} />
			))}
		</div>
	)}
	{!hasLinks && !hasChildren && (
		<ul class="links">
			<li class="empty">No links yet. Add some to this category.</li>
		</ul>
	)}
</article>

<style>
	.card {
		grid-column: span var(--card-width, 4);
		background: var(--card-bg, var(--panel));
		border: 1px solid var(--border);
		border-radius: 18px;
		padding: 18px 18px 14px;
		box-shadow: var(--shadow);
		backdrop-filter: blur(12px);
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.card:hover {
		transform: translateY(-2px);
		border-color: var(--muted);
	}

	.card--transparent {
		background: transparent;
		border: none;
		box-shadow: none;
		backdrop-filter: none;
	}

	.card--transparent:hover {
		transform: none;
		border-color: transparent;
	}

	.card__header {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 12px;
		align-items: center;
		margin-bottom: 8px;
	}

	.dot {
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: var(--dot, #7cc9ff);
		box-shadow: 0 0 0 6px rgba(255, 255, 255, 0.04);
	}

	.eyebrow {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 11px;
		color: var(--muted);
	}

	h2 {
		margin: 4px 0 4px;
		font-size: 18px;
		letter-spacing: -0.01em;
	}

	.muted {
		margin: 0;
		color: var(--muted);
		font-size: 14px;
		line-height: 1.45;
	}

	.links {
		list-style: none;
		margin: 8px 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.empty {
		color: var(--muted);
		font-size: 14px;
		padding: 8px 2px 6px;
	}

	.card__children {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		gap: 14px;
	}

	.card__children .card {
		padding: 14px 14px 12px;
	}

	@media (max-width: 640px) {
		.card {
			padding: 16px;
			grid-column: span 12;
		}

		.card__children {
			gap: 12px;
		}

		.card__children .card {
			padding: 10px;
		}
	}
</style>
