---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import LinkCard from '../components/LinkCard.astro';
import type { LinkData } from '../types.ts';
import linkData from '../data/links.yaml';

const data = linkData as LinkData;
const hero = data?.hero ?? {};
const categories = data?.categories ?? [];
const variantDefs = data?.variantDefs ?? {};
---

<Layout title={hero.title} description={hero.description}>
	<main class="shell">
		<Hero hero={hero} />

		{categories.length === 0 ? (
			<section class="empty">No categories yet. Add some to src/data/links.yaml.</section>
		) : (
			<section class="grid" aria-label="Link categories">
				{categories.map((category) => (
					<LinkCard category={category} parentVariantDefs={variantDefs} />
				))}
			</section>
		)}
	</main>
</Layout>

<style>
	.shell {
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 32px;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		gap: 18px;
	}

	.empty {
		color: var(--muted);
		font-size: 14px;
		padding: 8px 2px 6px;
	}

	@media (max-width: 640px) {
		.shell {
			gap: 24px;
		}
	}
</style>
